# ---------------------------------------------------------------------------
# KAI — modèle de configuration.  AUCUN SECRET ICI.
#
#   cp .env.example .env && chmod 600 .env
#
# Le fichier .env réel est exclu de Git (.gitignore) et n'est lu QUE par le
# backend / les scripts locaux.  Il n'est jamais exposé au navigateur (§9.1).
# Les clés API sont facultatives : le mode hors ligne ne doit dépendre
# d'AUCUNE d'entre elles (§4.2).
# ---------------------------------------------------------------------------

# === Réseau : localhost uniquement (§9.2, décision D-002) ==================
# Ne jamais mettre 0.0.0.0 sans décision explicite de Kevin.
KAI_BIND_HOST=127.0.0.1
KAI_WEBUI_PORT=8080
KAI_OLLAMA_HOST=127.0.0.1
KAI_OLLAMA_PORT=11434

# === Modèles locaux (§5, décision D-004) ===================================
# Tags épinglés — voir VERSIONS.md.  Ne jamais utiliser :latest en livraison.
KAI_MODEL_PRIMARY=qwen3.5:4b-q4_K_M
KAI_MODEL_FALLBACK=qwen3.5:2b-q4_K_M
KAI_MODEL_EMBEDDING=embeddinggemma:300m-qat-q8_0

# Contexte initial : 4096 sur Mac M1 8 Go.  Ne pas monter à 8192 avant
# validation mémoire par le benchmark (§5, R-008).
KAI_NUM_CTX=4096
# Un seul modèle chargé, aucun parallélisme (§5).
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
# Décharge le modèle après 5 min d'inactivité pour rendre la RAM à macOS.
OLLAMA_KEEP_ALIVE=5m

# === Mode hors ligne (§12 KAI-EXEC-004, R-002) =============================
# À 1, Open WebUI ne tente aucun téléchargement au démarrage.  C'est la
# configuration exigée pour le vol.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# Télémétrie désactivée (§9.2 : aucune télémétrie facultative).
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# === Open WebUI ============================================================
# Authentification locale : laisser à true si la machine peut être jointe sur
# le LAN (§9.2).  WEBUI_SECRET_KEY est généré par scripts/install-v0.sh et
# écrit dans .env — ne jamais le committer.
WEBUI_AUTH=true
WEBUI_SECRET_KEY=
# RAG servi par Ollama, donc pas de téléchargement de modèle d'embedding.
RAG_EMBEDDING_ENGINE=ollama
ENABLE_RAG_WEB_SEARCH=false

# === Clés API cloud — FACULTATIVES, ajoutées seulement en KAI-EXEC-005 =====
# Un fournisseur à la fois (décision D-005).  Laisser vide tant que la V0
# n'est pas validée par Kevin.  Ces variables ne sont lues que côté serveur.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Plafond de dépense mensuel indicatif, en euros, appliqué par la passerelle
# (§12 KAI-EXEC-005).  0 = aucun appel payant autorisé.
KAI_CLOUD_BUDGET_EUR=0

# === Emplacements de données (hors Git) ====================================
KAI_DATA_DIR=./data
KAI_BACKUP_DIR=./backups
